api.tonyshrimp.com.au {
    encode gzip

    reverse_proxy api:8000
}

pgadmin.tonyshrimp.com.au {
    encode gzip

    @not_allowed not remote_ip 171.253.191.210
    respond @not_allowed "Forbidden" 403

    header {
        X-Robots-Tag "noindex, nofollow"
    }

    basic_auth {
        {$PGADMIN_BASIC_AUTH_USER} {$PGADMIN_BASIC_AUTH_HASH}
    }

    reverse_proxy pgadmin:80
}
