APP_NAME="Tony Shrimp API"
ENVIRONMENT=development

# Local Docker defaults:
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=tony_shrimp

DATABASE_URL=postgresql+psycopg://admin:admin@localhost:5432/tony_shrimp
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_COOKIE_NAME=tony_access_token
REFRESH_TOKEN_COOKIE_NAME=tony_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# pgAdmin is only used in production compose if enabled.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_BASIC_AUTH_USER=admin
PGADMIN_BASIC_AUTH_HASH=

EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@tonyshrimp.local
EMAIL_LOGO_URL=https://tonyshrimp.com.au/logo/tony-shrimp-logo.png
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tony-shrimp-media
R2_PUBLIC_BASE_URL=
R2_PRESIGNED_URL_EXPIRE_SECONDS=300

PII_ENCRYPTION_KEY=

AUSTRALIAN_SUBURBS_LOOKUP_SUBURB_URL=https://australiansuburbs.au/api/lookup_suburb
AUSTRALIAN_SUBURBS_VALIDATE_URL=https://australiansuburbs.au/api/validate

ORDER_SHIPPING_FLAT_RATE_AMOUNT=25.00
ORDER_CURRENCY=AUD

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=aud
STRIPE_SUCCESS_URL=https://tonyshrimp.com.au/orders/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://tonyshrimp.com.au/cart
STRIPE_CHECKOUT_EXPIRES_AFTER_MINUTES=30

# Production example:
# ENVIRONMENT=production
# POSTGRES_USER=tony_shrimp
# POSTGRES_PASSWORD=replace-with-strong-password
# POSTGRES_DB=tony_shrimp
# DATABASE_URL=postgresql+psycopg://tony_shrimp:replace-with-strong-password@postgres:5432/tony_shrimp
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=https://your-frontend-domain.com
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=.your-domain.com
# EMAIL_PROVIDER=resend
# EMAIL_FROM=no-reply@your-domain.com
# EMAIL_LOGO_URL=https://tonyshrimp.com.au/logo/tony-shrimp-logo.png
# PGADMIN_DEFAULT_EMAIL=admin@your-domain.com
# PGADMIN_DEFAULT_PASSWORD=replace-with-strong-password
# PGADMIN_BASIC_AUTH_USER=admin
# PGADMIN_BASIC_AUTH_HASH=replace-with-caddy-hash
# STRIPE_SECRET_KEY=sk_live_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me
# STRIPE_CURRENCY=aud
# STRIPE_SUCCESS_URL=https://tonyshrimp.com.au/orders/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://tonyshrimp.com.au/cart
# STRIPE_CHECKOUT_EXPIRES_AFTER_MINUTES=30
